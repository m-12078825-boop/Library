// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("student") // super_admin, admin, librarian, teacher, student, parent
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  profileImage String?  @map("profile_image")
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  studentProfile      Student?      @relation("StudentUser")
  teacherClasses      Class[]       @relation("TeacherClasses")
  studentAttendance   Attendance[]  @relation("StudentAttendance")
  recordedAttendance  Attendance[]  @relation("RecordedBy")
  createdAnnouncements Announcement[] @relation("CreatedBy")
  reportedIncidents   Incident[]    @relation("ReportedBy")
  resolvedIncidents   Incident[]    @relation("ResolvedBy")
  bookLoans           BookLoan[]
  parentGuardians     Student[]     @relation("ParentGuardian")
  systemSettings      SystemSetting[]
  timetableEntries    Timetable[]
  incidentStudents    Incident[]    @relation("IncidentStudent")

  @@map("users")
}

model Student {
  userId           String   @unique @map("user_id")
  user             User     @relation("StudentUser", fields: [userId], references: [id], onDelete: Cascade)
  studentId        String   @unique @map("student_id")
  barcodeUrl       String?  @map("barcode_url")
  classId          String   @map("class_id")
  class            Class    @relation(fields: [classId], references: [id])
  enrollmentDate   DateTime @default(now()) @map("enrollment_date")
  dateOfBirth      DateTime @map("date_of_birth")
  gender           String   @default("other") // male, female, other
  address          String?
  emergencyContact String?  @map("emergency_contact")
  academicYear     String   @map("academic_year")
  promotionStatus  String   @default("promoted") @map("promotion_status") // promoted, retained, graduated
  parentGuardianId String?  @map("parent_guardian_id")
  parentGuardian   User?    @relation("ParentGuardian", fields: [parentGuardianId], references: [id])

  // Relations
  attendance Attendance[]
  bookLoans  BookLoan[]
  incidents  Incident[]

  @@map("students")
}

model Class {
  id                String   @id @default(cuid())
  name              String
  gradeLevel        Int      @map("grade_level")
  academicYear      String   @map("academic_year")
  teacherId         String?  @map("teacher_id")
  teacher           User?    @relation("TeacherClasses", fields: [teacherId], references: [id])
  maxCapacity       Int      @default(40) @map("max_capacity")
  currentEnrollment Int      @default(0) @map("current_enrollment")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  students      Student[]
  attendance    Attendance[]
  timetable     Timetable[]
  announcements Announcement[]

  @@map("classes")
}

model Book {
  id              String   @id @default(cuid())
  isbn            String?  @unique
  title           String
  author          String
  publisher       String?
  publicationYear Int?     @map("publication_year")
  genre           String?
  barcode         String   @unique
  barcodeUrl      String?  @map("barcode_url")
  totalCopies     Int      @map("total_copies")
  availableCopies Int      @map("available_copies")
  location        String?
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  bookLoans BookLoan[]

  @@map("books")
}

model BookLoan {
  id         String   @id @default(cuid())
  bookId     String   @map("book_id")
  book       Book     @relation(fields: [bookId], references: [id])
  studentId  String   @map("student_id")
  student    User     @relation(fields: [studentId], references: [id])
  loanDate   DateTime @default(now()) @map("loan_date")
  dueDate    DateTime @map("due_date")
  returnDate DateTime? @map("return_date")
  status     String   @default("active") // active, returned, overdue
  fineAmount Float    @default(0.00) @map("fine_amount")
  finePaid   Boolean  @default(false) @map("fine_paid")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("book_loans")
}

model Attendance {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  student     User     @relation("StudentAttendance", fields: [studentId], references: [id])
  classId     String   @map("class_id")
  class       Class    @relation(fields: [classId], references: [id])
  date        DateTime
  status      String   // present, absent, late, excused
  arrivalTime String?  @map("arrival_time")
  notes       String?
  recordedBy  String   @map("recorded_by")
  recorder    User     @relation("RecordedBy", fields: [recordedBy], references: [id])
  recordedAt  DateTime @default(now()) @map("recorded_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([studentId, date])
  @@map("attendance_records")
}

model Timetable {
  id           String   @id @default(cuid())
  classId      String   @map("class_id")
  class        Class    @relation(fields: [classId], references: [id])
  subject      String
  teacherId    String   @map("teacher_id")
  teacher      User     @relation(fields: [teacherId], references: [id])
  dayOfWeek    Int      @map("day_of_week")
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  room         String?
  academicYear String   @map("academic_year")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("timetable")
}

model Announcement {
  id              String   @id @default(cuid())
  title           String
  content         String
  authorId        String   @map("author_id")
  author          User     @relation("CreatedBy", fields: [authorId], references: [id])
  targetAudience  String   @map("target_audience") // all, students, teachers, parents, specific_class
  targetClassId   String?  @map("target_class_id")
  targetClass     Class?   @relation(fields: [targetClassId], references: [id])
  attachmentUrls  String?  @map("attachment_urls")
  scheduledAt     DateTime? @map("scheduled_at")
  isPublished     Boolean  @default(false) @map("is_published")
  priority        String   @default("medium") // low, medium, high, urgent
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

model Incident {
  id             String   @id @default(cuid())
  title          String
  description    String
  incidentType   String   @map("incident_type") // academic, behavioral, medical, other
  severity       String   // low, medium, high, critical
  studentId      String?  @map("student_id")
  student        User?    @relation("IncidentStudent", fields: [studentId], references: [id])
  reportedBy     String   @map("reported_by")
  reporter       User     @relation("ReportedBy", fields: [reportedBy], references: [id])
  resolvedBy     String?  @map("resolved_by")
  resolver       User?    @relation("ResolvedBy", fields: [resolvedBy], references: [id])
  status         String   @default("open") // open, investigating, resolved, closed
  incidentDate   DateTime @map("incident_date")
  resolutionDate DateTime? @map("resolution_date")
  notes          String?
  attachmentUrls String?  @map("attachment_urls")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("incidents")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  category    String
  updatedBy   String   @map("updated_by")
  updater     User     @relation(fields: [updatedBy], references: [id])
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}